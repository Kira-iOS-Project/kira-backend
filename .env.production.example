# The keys production reads. Their values live in Dokploy (project Kira, application Back-End,
# Environment), never in a file: this template documents the keys and holds no value.
NODE_ENV=production
PORT=3000

# Postgres on Dokploy's internal network: the database service's app name as the host, port 5432.
DATABASE_URL=postgresql://kira:<password>@<kira-postgres-app-name>:5432/kira

CORS_ORIGINS=
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=10000
REQUEST_TIMEOUT_MS=15000
BODY_LIMIT_BYTES=1048576
DOCS_ENABLED=false
LOG_LEVEL=info

# Resend: the API key (required in production) and a sender on a verified domain.
RESEND_API_KEY=<resend-api-key>
EMAIL_FROM=Kira <noreply@<verified-domain>>

# At least 32 random characters (`openssl rand -base64 48`). Required in production. Changing it
# invalidates the codes in flight, nothing else.
AUTH_SECRET=<random-secret>

# The public base URL of this API, where /email/*.png is served for the images inside emails.
PUBLIC_BASE_URL=https://<api-host>

# The hourly scheduler. true on exactly one replica.
JOBS_ENABLED=true

# The verified links of the curated community groups and Etalase products, set by the curation
# team: a JSON object from a group's or a product's id to its https link. Unset: no group can be
# joined and no seller page opens until the team adds them.
COMMUNITY_LINKS_JSON={}
