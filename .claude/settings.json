{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Read(**)",
      "Bash(bun run test:*)",
      "Bash(bun run type-check:*)",
      "Bash(bun run lint:*)",
      "Bash(bun run format:*)",
      "Bash(bun run fl:*)",
      "Bash(bun run check:*)",
      "Bash(bun run db:generate:*)",
      "Bash(bun fl:*)",
      "Bash(bun test:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git push origin dev:*)",
      "Bash(git push origin prod:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin master:*)",
      "Edit(.env*)",
      "Edit(!.env*.example)",
      "Edit(.claude/state/**)",
      "Read(.env*)",
      "Read(!.env*.example)",
      "Read(.claude/state/env-backups/**)",
      "Edit(SSOT.md)",
      "Edit(AGENTS.md)"
    ],
    "ask": [
      "mcp__db-prod__execute_sql",
      "Edit(.claude/agent-config.json)",
      "Edit(.claude/agent-config-kit.lock)",
      "Edit(.claude/hooks/**)",
      "Edit(scripts/check/hook-probes.*)",
      "Edit(scripts/ops/unlock.sh)",
      "Edit(scripts/env/**)",
      "Bash(bash scripts/deploy/verify-deploy.sh:*)",
      "Bash(bash ./scripts/deploy/verify-deploy.sh:*)",
      "Bash(./scripts/deploy/verify-deploy.sh:*)",
      "Bash(scripts/deploy/verify-deploy.sh:*)",
      "Bash(bash scripts/deploy/trigger-deploy.sh:*)",
      "Bash(bash ./scripts/deploy/trigger-deploy.sh:*)",
      "Bash(./scripts/deploy/trigger-deploy.sh:*)",
      "Bash(scripts/deploy/trigger-deploy.sh:*)"
    ]
  },
  "enabledPlugins": {
    "agent-core@agent-config-kit": true,
    "agent-be-hono@agent-config-kit": true,
    "agent-deploy@agent-config-kit": true
  },
  "extraKnownMarketplaces": {
    "agent-config-kit": {
      "source": {
        "source": "github",
        "repo": "adhibuchori/agent-config-kit"
      }
    }
  },
  "sandbox": {
    "enabled": true,
    "filesystem": {
      "denyWrite": [
        ".claude/state/unlock",
        ".claude/state/unlock/**"
      ],
      "denyRead": [
        ".env",
        ".env.*",
        ".env-*",
        ".env_*",
        ".envrc",
        "./**/.env",
        "./**/.env.*",
        "./**/.env-*",
        "./**/.env_*",
        "./**/.envrc",
        ".claude/state/env-backups",
        ".claude/state/env-backups/**"
      ],
      "allowRead": [
        ".env.example",
        ".env.*.example",
        ".env-*.example",
        ".env_*.example",
        "./**/.env.example",
        "./**/.env.*.example",
        "./**/.env-*.example",
        "./**/.env_*.example"
      ]
    },
    "excludedCommands": [
      "bash scripts/env/show.sh*",
      "bash scripts/env/set.sh*",
      "./scripts/env/show.sh*",
      "./scripts/env/set.sh*",
      "scripts/env/show.sh*",
      "scripts/env/set.sh*"
    ]
  }
}
