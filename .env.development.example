# Local development. `bun run env:init` copies this file to .env.development (gitignored), which
# Bun loads by itself when NODE_ENV=development. Never commit a real value here: this template is
# public to everyone with the repo.
NODE_ENV=development
PORT=3000

# The development database on the VPS, through the SSH tunnel (`bun run tunnel`, then leave it
# running). Setup wrote the real password into your .env.development; a new clone asks the owner,
# who can reset it as the provisioning superuser of DB-Kira-Dev (Dokploy holds that one).
DATABASE_URL=postgresql://kira_dev:<password>@127.0.0.1:5437/kira_dev

# Browser origins allowed by CORS, comma-separated. The iOS app needs none.
CORS_ORIGINS=

# /docs and /openapi.json: on by default outside production.
# DOCS_ENABLED=true
# LOG_LEVEL=debug

# Email through Resend. Leave RESEND_API_KEY empty to have every email, sign-in codes included,
# written to the log instead of sent. EMAIL_FROM must be on a domain verified in Resend.
RESEND_API_KEY=
# EMAIL_FROM=Kira <noreply@your-verified-domain>

# Signs the stored sign-in codes; at least 32 characters. Unset, each process picks a random one,
# so codes do not survive a restart.
# AUTH_SECRET=

# The base URL the images inside emails load from (/email/*.png); the server serves them itself.
# PUBLIC_BASE_URL=http://localhost:3000

# The hourly in-process jobs (renewals, Beasiswa Kira reviews, code cleanup). On by default.
# JOBS_ENABLED=true
