{
  "name": "kira-backend",
  "version": "0.1.0",
  "private": true,
  "description": "The Kira API: Bun, Hono and Drizzle on PostgreSQL.",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun scripts/build/bundle.ts",
    "start": "bun dist/index.js",
    "test:integration": "RUN_INTEGRATION_TESTS=1 bun test src",
    "env:init": "test -f .env.development || cp .env.development.example .env.development",
    "tunnel": "ssh -N -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -o ExitOnForwardFailure=yes -L 5437:127.0.0.1:5437 -L 5436:127.0.0.1:5436 codesheesh-server",
    "check:audit": "bun scripts/check/audit.ts",
    "prepare": "husky",
    "unlock": "bash scripts/ops/unlock.sh",
    "check:constants": "bun scripts/check/constants.ts",
    "check:dockerfile": "bun scripts/check/dockerfile.ts",
    "check:coverage-policy": "node scripts/check/coverage-policy.mjs",
    "check:dead-code": "knip",
    "check:folder-shape": "node scripts/check/folder-shape.mjs",
    "check:mocks": "bun scripts/check/module-mocks.ts",
    "db:generate": "drizzle-kit generate",
    "fl": "bun run format && bun run lint",
    "fl:ci": "bun run format:check && oxlint --type-aware src scripts",
    "format": "oxfmt src scripts",
    "format:check": "oxfmt --check src scripts",
    "lint": "oxlint --type-aware src scripts",
    "test:coverage": "bun test src --coverage && node scripts/check/coverage-files.mjs",
    "type-check": "tsc --noEmit",
    "check:crypto-interop": "if [ -f scripts/check/crypto-interop.ts ]; then bun scripts/check/crypto-interop.ts ; else echo 'check:crypto-interop skipped: setup did not install the payload module'; fi",
    "check:endpoints": "if [ -f scripts/check/endpoints.ts ]; then bun scripts/check/endpoints.ts ; else echo 'check:endpoints skipped: setup did not install the payload module'; fi",
    "check:openapi": "bun scripts/check/openapi.ts",
    "generate:endpoints": "bun scripts/generate/endpoints.ts",
    "spec:export": "bun scripts/generate/openapi.ts"
  },
  "dependencies": {
    "@hono/zod-openapi": "1.6.3",
    "@scalar/hono-api-reference": "0.12.11",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.13",
    "pino": "10.4.0",
    "postgres": "3.4.9",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "drizzle-kit": "0.31.11",
    "husky": "9.1.7",
    "knip": "6.40.0",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2003",
    "pino-pretty": "13.2.0",
    "typescript": "7.0.2"
  }
}
